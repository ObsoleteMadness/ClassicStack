# ClassicStack configuration (server.toml)
#
# Copy this file to server.toml and edit. The interactive binary auto-loads
# ./server.toml; override with `classicstack -config /path/to/server.toml`.
# A MISSING file is fine — the stack boots on the built-in default model.
#
# Format is TOML, parsed and re-emitted by adapter/config/toml. NOTE: when the
# web-admin UI (or any control-plane Save) rewrites this file it KEEPS only the
# values, dropping comments, and backs up the previous version to
# server.toml.NNNN first. So treat hand-written comments here as a reference,
# not something the running server preserves.
#
# Sections come in three shapes:
#   - well-known singletons:   [identity] [logging] [router] [bridge] [adminauth]
#   - the interface namespace: repeated [[interface]] array-of-tables
#   - transports:              repeated [[ethertalk]] [[ltoudp]] [[tashtalk]]
#                                       [[ipx]] [[netbeui]] (lower-case, array-of-tables)
#   - file-service shares:     repeated [[afpvolumes]] / [[smbshares]]
#
# Repeated sections use TOML array-of-tables ([[name]]) so a transport can have
# several named instances (e.g. two TashTalk dongles). The table key is the
# LOWER-CASED schema key; the per-instance `name` distinguishes instances.
#
# A build only honours the sections whose component was compiled in (build tags
# afp, smb, ipx, netbeui, macip, webui, … or `all`). An unknown section is
# ignored, so a config can carry sections a slim build does not use.


# --- Server identity (§4-bis) ------------------------------------------------
# One identity owned by no single service. hostname is also the AFP server name
# and, when NetBIOS/SMB is enabled, the NetBIOS computer name (then capped at 15
# bytes). workgroup is the SMB workgroup / browse domain.
[identity]
hostname = "classicstack"
workgroup = "WORKGROUP"
description = "ClassicStack file server"


# --- Logging -----------------------------------------------------------------
# Level is debug | info | warn | error. (Field key is capitalised "Level"
# because LoggingSection carries no toml tag — the codec emits the Go field
# name; both "Level" and lowercase are accepted on read.)
[logging]
Level = "info"


# --- AppleTalk router (§3d) --------------------------------------------------
# members lists, by INSTANCE NAME, the transport ports that JOIN the AppleTalk
# router (RTMP/ZIP + inter-port forwarding). A port NOT listed still comes up
# and serves its own segment, but standalone. An EMPTY members list means NO
# port joins (explicit-over-implicit — there is no "bind everything" default).
# Instance names default to the section key ("EtherTalk", "LToUDP", …) unless a
# port sets its own `name`.
[router]
default_zone = "EtherTalk Network"
members = ["EtherTalk", "LToUDP"]


# --- Default / bridge interface (§M11) ---------------------------------------
# The interface a transport binds to when it names none of its own. A bridge
# aggregates member NICs; a plain NIC needs only Kind="nic". (Field keys are
# capitalised — InterfaceSection carries no toml tags.) Kind is nic|serial|bridge.
[bridge]
Name = "br-lan"
Kind = "bridge"
Members = ["eth0"]


# --- Interface namespace (§M11) ----------------------------------------------
# Named interfaces a transport's `iface` can reference. A bare name a transport
# uses without a matching [[interface]] entry is treated as a plain NIC, so you
# only need an entry here to pin a kind/params (a serial device, a bridge).
[[interface]]
Name = "eth0"
Kind = "nic"

[[interface]]
Name = "ttyAMA0"
Kind = "serial"
Device = "/dev/ttyAMA0"
Baud = 1000000


# --- Transports --------------------------------------------------------------
# Every transport shares one section shape (a superset; each reads only the
# fields that apply to it). Common fields:
#   name             per-instance identity (blank = the lone default instance,
#                    whose name falls back to the section key)
#   iface            interface-namespace name to bind to (blank = inherit [bridge])
#   enabled          true/false
#   mac              station MAC for EtherTalk (blank = use the interface's own)
#   seed_network     AppleTalk seed network number (0 = non-seed: learn from a peer)
#   seed_network_end upper bound of an extended-network range (0 = single number)
#   seed_zone        default zone this port seeds (blank = non-seed / inherit)

# EtherTalk — DDP over raw Ethernet (libpcap/Npcap; needs -tags pcap to capture).
[[ethertalk]]
iface = "eth0"
enabled = true
seed_network = 3
seed_network_end = 5
seed_zone = "EtherTalk Network"

# LToUDP — LocalTalk over UDP multicast (239.192.76.84:1954). No NIC privilege
# needed; the simplest transport (Mini vMac UDP builds, SNOW). Blank iface joins
# every multicast-capable interface.
[[ltoudp]]
enabled = true
seed_network = 1
seed_zone = "LToUDP Network"

# TashTalk — a PIC-based RS422 LocalTalk-to-serial adaptor. Binds a serial-kind
# interface (set its device/baud in [[interface]]).
[[tashtalk]]
iface = "ttyAMA0"
enabled = false
seed_network = 2
seed_zone = "TashTalk Network"

# IPX — Novell IPX over Ethernet (a NetBIOS/SMB transport, not an AppleTalk
# router member; build tag `ipx`). Inherits [bridge] when iface is blank.
[[ipx]]
iface = "eth0"
enabled = false

# NetBEUI — NBF over 802.2 LLC (a NetBIOS/SMB transport; build tag `netbeui`).
[[netbeui]]
iface = "eth0"
enabled = false


# --- AFP volumes (build tag `afp`) -------------------------------------------
# One [[afpvolumes]] table per exported volume. The AFP service is present when
# built; it serves the volumes listed here (zero volumes = no shares). There is
# no top-level [AFP] enable/protocol block in the current model — DDP vs TCP
# transport follows which AppleTalk/network transports are up.
#   name           volume display name (max 31 chars)
#   path           host directory
#   fs_type        filesystem backend: local_fs (default), memfs, …
#   fork_backend   appledouble | ads | xattr | native | auto (blank = default)
#   filename_codec wire↔store name codec (blank = default)
#   read_only      true makes the whole volume read-only
#   allowed_users  access allow-list (empty = guest/world)
#   options        backend-specific "key=value" params (e.g. for an image backend)
[[afpvolumes]]
name = "Public"
fs_type = "local_fs"
path = "/srv/afp/public"
read_only = false

# [[afpvolumes]]
# name = "Archive"
# fs_type = "local_fs"
# path = "/srv/afp/archive"
# read_only = true
# allowed_users = ["alice", "bob"]


# --- SMB shares (build tag `smb`) --------------------------------------------
# One [[smbshares]] table per exported share. Mirrors [[afpvolumes]] with an
# extra `description` (the NetShareEnum remark). An SMB share and an AFP volume
# on the SAME host path share a mutation bus so each sees the other's changes.
[[smbshares]]
name = "public"
description = "Public share"
fs_type = "local_fs"
path = "/srv/smb/public"
read_only = false


# --- Web-admin credential (§4-ter) -------------------------------------------
# [adminauth] is written by the FIRST-RUN setup of the web-admin UI (it stores a
# username + a salted PBKDF2-SHA256 hash, never a cleartext password). Do not
# author it by hand — leaving it absent is what marks the server "needs setup".
# Serve the web-admin API with:  classicstack -http :8080
# (HTTP Basic over the chosen address; run it over loopback or behind TLS.)
#
# [adminauth]
# user = "admin"
# salt = "…hex…"
# hash = "…hex…"
